# Zkopíruj do .env a uprav. .env je v .gitignore a nikdy se necommituje.

# Postgres. Výchozí hodnota odpovídá docker-compose.yml.
DATABASE_URL="postgres://slib:slib@localhost:5432/slib_skutek"

# AI provider (fáze 4). Ve vývoji a v testech běží "fixture" a nestojí nic.
AI_PROVIDER="fixture"
# ANTHROPIC_API_KEY=""

# Lokální model přes Ollamu. Použije se jen při AI_PROVIDER="local".
# AI_LOCAL_URL="http://localhost:11434"
# AI_LOCAL_MODEL="qwen3:8b"

# Tajny klic pro otisky IP adres. POVINNY, bez vychozi hodnoty.

# Vygeneruj vlastni: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Tenhle je priklad z repozitare — v provozu je bezcenny, musis ho vymenit.

IP_HASH_SECRET=zmen-me-vygenerovanym-nahodnym-klicem-aspon-32-znaku

