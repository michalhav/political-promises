# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# šablona do repozitáře patří — README na ni odkazuje
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env
.env.local
.env*.local

# test output
coverage
playwright-report
test-results
# pracovní výstup snímků; zmrazená sada je v docs/design/
/e2e/screenshots

# korpus: zdrojové dokumenty do repozitáře nepatří, odvozené artefakty ano
#
# Je to seznam povolených, ne zakázaných. Nový formát zdroje tak zůstane venku
# sám od sebe — opačně by stačilo zapomenout na příponu a cizí dokument by se
# ticho ocitl v repozitáři. Přesně to se stalo s .html, když seznam uměl jen .pdf.
/corpus/*/*
!/corpus/*/provenance.json
!/corpus/*/extracted.json
!/corpus/*/golden.json
!/corpus/*/golden.draft.json
!/corpus/*/evaluation.json
!/corpus/*/diagnostics.json
!/corpus/*/tabulka.txt
!/corpus/*/*.md
!/corpus/*/qa/
